; Engine configuration file.
; Edit through the Godot editor where possible.
config_version=5

[application]
config/name="Abyssal Protocol"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameEvents="*res://src/core/game_events.gd"
InputBootstrap="*res://src/core/input_bootstrap.gd"
ScreenshotCapture="*res://src/core/screenshot_capture.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
